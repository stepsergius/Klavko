<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks the microphone without this (voice input). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Hardened runtime with an ad hoc signature loads only Klavko's own code without this: sherpa-onnx and
         ONNX Runtime in Contents/Frameworks (Cohere Transcribe) are signed separately. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
